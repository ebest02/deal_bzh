{
    "name": "deal-bzh/application",
    "description": "Plateforme d'échange et de partage de matériel DEAL.BZH",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "laminas/laminas-component-installer": "^3.0",
        "laminas/laminas-mvc": "^3.5",
        "laminas/laminas-db": "^2.19",
        "laminas/laminas-authentication": "^2.12",
        "laminas/laminas-form": "^3.3",
        "laminas/laminas-inputfilter": "^2.18",
        "laminas/laminas-validator": "^2.24",
        "laminas/laminas-session": "^2.15",
        "laminas/laminas-filter": "^2.20",
        "laminas/laminas-hydrator": "^4.8",
        "laminas/laminas-view": "^2.24",
        "laminas/laminas-navigation": "^2.15",
        "laminas/laminas-paginator": "^2.15",
        "laminas/laminas-mail": "^2.25",
        "laminas/laminas-cache": "^3.0",
        "laminas/laminas-cache-storage-adapter-filesystem": "^2.0",
        "laminas/laminas-i18n": "^2.20",
        "laminas/laminas-router": "^3.11",
        "monolog/monolog": "^3.9"
    },
    "require-dev": {
        "laminas/laminas-development-mode": "^3.9"
    },
    "config": {
        "allow-plugins": {
            "laminas/laminas-component-installer": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "platform-check": false
    },
    "autoload": {
        "psr-4": {
            "Application\\": "module/Application/src/",
            "User\\": "module/User/src/",
            "Deal\\": "module/Deal/src/",
            "Message\\": "module/Message/src/",
            "Admin\\": "module/Admin/src/"
        }
    },
    "scripts": {
        "serve": "php -S 0.0.0.0:8080 -t public public/index.php",
        "development-disable": "laminas-development-mode disable",
        "development-enable": "laminas-development-mode enable",
        "development-status": "laminas-development-mode status"
    }
}
