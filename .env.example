# Configuration DEAL.BZH
# Copiez ce fichier vers .env et remplissez les valeurs

# ============================================
# BASE DE DONNÉES
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=deal_bzh
DB_USER=deal_bzh
DB_PASSWORD=CHANGE_ME

# ============================================
# DOCKER & KUBERNETES
# ============================================
DOCKER_REGISTRY=YOUR_REGISTRY
DOCKER_IMAGE_NAME=deal-bzh
KUBERNETES_NAMESPACE=deal-bzh
KUBERNETES_CONTEXT=YOUR_KUBERNETES_CONTEXT

# ============================================
# GITHUB ACTIONS SECRETS
# ============================================
# Pour GitHub Container Registry (ghcr.io)
GITHUB_REGISTRY_USERNAME=YOUR_GITHUB_USERNAME
GITHUB_REGISTRY_TOKEN=ghp_YOUR_PERSONAL_ACCESS_TOKEN

# Pour Docker Hub
DOCKER_HUB_USERNAME=YOUR_DOCKERHUB_USERNAME
DOCKER_HUB_TOKEN=YOUR_DOCKERHUB_TOKEN

# Kubeconfig encodé en base64
# Générer avec: cat ~/.kube/config | base64 -w 0
KUBECONFIG_BASE64=YOUR_KUBECONFIG_BASE64

# ============================================
# APPLICATION
# ============================================
APP_ENV=production
APP_DEBUG=false
APP_NAME=DEAL.BZH
APP_URL=https://deal.bzh

# ============================================
# SESSION
# ============================================
SESSION_NAME=deal_bzh_session
SESSION_LIFETIME=7200

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_CHANNEL=file

# ============================================
# MYSQL (si déployé dans Kubernetes)
# ============================================
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# ============================================
# SÉCURITÉ (optionnel)
# ============================================
# Clé de chiffrement pour les sessions (générer avec: openssl rand -base64 32)
APP_KEY=
# Clé pour CSRF (générer avec: openssl rand -base64 32)
CSRF_SECRET=

# ============================================
# EMAIL (optionnel)
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@deal.bzh
MAIL_FROM_NAME="DEAL.BZH"

# ============================================
# UPLOAD
# ============================================
UPLOAD_MAX_SIZE=20M
UPLOAD_PATH=data/uploads

# ============================================
# CACHE
# ============================================
CACHE_DRIVER=file
CACHE_PATH=data/cache
