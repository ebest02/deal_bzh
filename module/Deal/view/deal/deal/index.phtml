<h1>Annonces</h1>

<div class="filters">
    <form method="get" action="<?= $this->url('deal') ?>">
        <div class="form-group">
            <label>Recherche</label>
            <input type="text" name="search" value="<?= $this->escapeHtml($this->filters['search'] ?? '') ?>" class="form-control" />
        </div>
        <div class="form-group">
            <label>Catégorie</label>
            <select name="category_id" class="form-control">
                <option value="">Toutes</option>
                <?php foreach ($this->categories as $category): ?>
                    <option value="<?= $category->getId() ?>" <?= ($this->filters['category_id'] == $category->getId()) ? 'selected' : '' ?>>
                        <?= $this->escapeHtml($category->getName()) ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>
        <div class="form-group">
            <label>Type</label>
            <select name="type" class="form-control">
                <option value="">Tous</option>
                <option value="exchange" <?= ($this->filters['type'] == 'exchange') ? 'selected' : '' ?>>Échange</option>
                <option value="swap" <?= ($this->filters['type'] == 'swap') ? 'selected' : '' ?>>Troc</option>
                <option value="free_service" <?= ($this->filters['type'] == 'free_service') ? 'selected' : '' ?>>Service gratuit</option>
                <option value="sale" <?= ($this->filters['type'] == 'sale') ? 'selected' : '' ?>>Vente</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Filtrer</button>
    </form>
</div>

<div class="deals-list">
    <?php if (count($this->paginator) > 0): ?>
        <?php foreach ($this->paginator as $deal): ?>
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">
                        <a href="<?= $this->url('deal/view', ['id' => $deal->getId()]) ?>">
                            <?= $this->escapeHtml($deal->getTitle()) ?>
                        </a>
                    </h2>
                </div>
                <div class="card-body">
                    <p><?= $this->escapeHtml(mb_substr($deal->getDescription(), 0, 200)) ?>...</p>
                    <p><strong>Catégorie:</strong> <?= $this->escapeHtml($deal->getCategory()->getName()) ?></p>
                    <p><strong>Type:</strong> 
                        <?php
                        $types = [
                            'exchange' => 'Échange',
                            'swap' => 'Troc',
                            'free_service' => 'Service gratuit',
                            'sale' => 'Vente',
                        ];
                        echo $types[$deal->getType()] ?? $deal->getType();
                        ?>
                    </p>
                    <?php if ($deal->getPrice()): ?>
                        <p><strong>Prix:</strong> <?= number_format($deal->getPrice(), 2) ?> €
                            <?php if ($deal->getIsNegotiable()): ?>
                                <em>(négociable)</em>
                            <?php endif; ?>
                        </p>
                    <?php endif; ?>
                    <?php if ($deal->getLocation()): ?>
                        <p><strong>Localisation:</strong> <?= $this->escapeHtml($deal->getLocation()) ?></p>
                    <?php endif; ?>
                    <p><small>Publié le <?= $deal->getPublishedAt()->format('d/m/Y') ?> - <?= $deal->getViews() ?> vues</small></p>
                </div>
            </div>
        <?php endforeach; ?>

        <?php if ($this->paginator->count() > 1): ?>
            <div class="pagination">
                <?= $this->paginationControl($this->paginator, 'Sliding', 'partial/paginator', ['route' => 'deal']) ?>
            </div>
        <?php endif; ?>
    <?php else: ?>
        <p>Aucune annonce trouvée.</p>
    <?php endif; ?>
</div>

