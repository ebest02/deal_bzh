<h1>Modifier l'utilisateur</h1>

<form method="post" action="<?= $this->url('admin/users/edit', ['id' => $this->user->getId()]) ?>">
    <div class="form-group">
        <label>Email</label>
        <input type="email" value="<?= $this->escapeHtml($this->user->getEmail()) ?>" disabled class="form-control" />
        <small>L'email ne peut pas être modifié</small>
    </div>

    <div class="form-group">
        <label for="first_name">Prénom</label>
        <input type="text" name="first_name" id="first_name" value="<?= $this->escapeHtml($this->user->getFirstName()) ?>" class="form-control" />
    </div>

    <div class="form-group">
        <label for="last_name">Nom</label>
        <input type="text" name="last_name" id="last_name" value="<?= $this->escapeHtml($this->user->getLastName()) ?>" class="form-control" />
    </div>

    <div class="form-group">
        <label for="phone">Téléphone</label>
        <input type="text" name="phone" id="phone" value="<?= $this->escapeHtml($this->user->getPhone()) ?>" class="form-control" />
    </div>

    <div class="form-group">
        <label for="role">Rôle</label>
        <select name="role" id="role" class="form-control">
            <option value="user" <?= $this->user->getRole() === 'user' ? 'selected' : '' ?>>Utilisateur</option>
            <option value="moderator" <?= $this->user->getRole() === 'moderator' ? 'selected' : '' ?>>Modérateur</option>
            <option value="admin" <?= $this->user->getRole() === 'admin' ? 'selected' : '' ?>>Administrateur</option>
        </select>
    </div>

    <div class="form-group">
        <label>
            <input type="checkbox" name="is_active" value="1" <?= $this->user->getIsActive() ? 'checked' : '' ?> />
            Actif
        </label>
    </div>

    <div class="form-group">
        <label for="password">Nouveau mot de passe (laisser vide pour ne pas changer)</label>
        <input type="password" name="password" id="password" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Enregistrer</button>
    <a href="<?= $this->url('admin/users/view', ['id' => $this->user->getId()]) ?>" class="btn btn-secondary">Annuler</a>
</form>

